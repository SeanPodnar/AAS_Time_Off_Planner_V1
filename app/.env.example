# Copy to .env.local for development. Never commit real values.
# Admin (owner) role: runs migrations only.
DATABASE_URL_ADMIN=postgres://postgres:postgres@localhost:5432/aas_dev
# Runtime roles. migrate.ts creates them with these passwords.
DATABASE_URL_APP=postgres://aas_app:change-me-app@localhost:5432/aas_dev
DATABASE_URL_PLATFORM=postgres://aas_platform:change-me-platform@localhost:5432/aas_dev
# Platform root domain. In development, companies are reached at <subdomain>.localhost:3000
ROOT_DOMAIN=localhost
# In development, sign-in emails are printed to the terminal running `npm run dev`.
